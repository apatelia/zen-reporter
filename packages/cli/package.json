{
  "name": "@arpanp/zen-cli",
  "version": "1.0.0-dev",
  "type": "module",
  "description": "Interactive terminal dashboard, CLI utilities, and history engine for Zen Reporter",
  "bin": {
    "zen-reporter": "bin/zen-reporter.js",
    "zr": "bin/zen-reporter.js"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "author": {
    "name": "Arpan Patelia",
    "email": "arpan.is@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.5.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build:cli": "vite build --config vite.cli.config.ts && tsc -p tsconfig.json",
    "build": "mkdir -p dist && npm run build:cli"
  },
  "dependencies": {
    "@arpanp/zen-core": "^1.0.0-dev",
    "@clack/prompts": "^1.9.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@duckdb/node-api": ">=2.0.0-r.1"
  },
  "peerDependenciesMeta": {
    "@duckdb/node-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
