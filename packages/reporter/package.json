{
  "name": "@arpanp/zen-reporter",
  "version": "0.20.0-dev",
  "type": "module",
  "description": "Beautiful test execution reports for Playwright",
  "bin": {
    "zen-reporter": "bin/zen-reporter.js",
    "zr": "bin/zen-reporter.js"
  },
  "main": "dist/reporter.cjs",
  "module": "dist/reporter.js",
  "types": "dist/reporter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "require": "./dist/reporter.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "author": {
    "name": "Arpan Patelia",
    "email": "arpan.is@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:reporter": "vite build --config vite.reporter.config.ts && tsc -p tsconfig.lib.json",
    "build:template": "node scripts/copy-template.mjs",
    "build": "mkdir -p dist && npm run build:template && npm run build:reporter"
  },
  "dependencies": {
    "@arpanp/zen-core": "^0.20.0-dev",
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@duckdb/node-api": ">=2.0.0-r.1",
    "@playwright/test": ">=1.63.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arpanp/zen-ui": "^0.20.0-dev",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
