{
  "name": "@arpanp/zen-reporter",
  "private": false,
  "version": "0.14.1",
  "type": "module",
  "description": "Beautiful test execution reports for Playwright",
  "bin": {
    "zen-reporter": "bin/zen-reporter.js",
    "zr": "bin/zen-reporter.js"
  },
  "main": "dist/reporter.cjs",
  "module": "dist/reporter.js",
  "types": "dist/reporter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "require": "./dist/reporter.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "author": {
    "name": "Arpan Patelia",
    "email": "arpan.is@gmail.com"
  },
  "license": "MIT",
  "repository": "github:apatelia/zen-reporter",
  "homepage": "https://zen-reporter.vercel.app",
  "keywords": [
    "playwright",
    "testing",
    "report",
    "reporter",
    "automation",
    "test automation"
  ],
  "scripts": {
    "dev": "vite",
    "build": "ZEN_REPORTER_DATA_FREE=true vite build && vite build --config vite.reporter.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "test": "npx playwright test",
    "report": "npm run build && node scripts/generate_report.js",
    "show": "node bin/zen-reporter.js show",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepack": "npm run build",
    "prepublish": "npm run build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@duckdb/node-api": ">=1.5.5",
    "@playwright/test": ">=1.63.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@eslint-react/eslint-plugin": "^5.23.5",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
