{
  "name": "zen-reporter-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "author": {
    "name": "Arpan Patelia",
    "email": "arpan.is@gmail.com"
  },
  "license": "MIT",
  "repository": "github:apatelia/zen-reporter",
  "homepage": "https://zen-reporter.vercel.app",
  "keywords": [
    "playwright",
    "testing",
    "report",
    "reporter",
    "automation",
    "test automation"
  ],
  "scripts": {
    "dev": "npm run dev -w @arpanp/zen-ui",
    "build:core": "npm run build -w @arpanp/zen-core",
    "build:ui": "npm run build -w @arpanp/zen-ui",
    "build:reporter": "npm run build -w @arpanp/zen-reporter",
    "build": "npm run build:core && npm run build:ui && npm run build:reporter",
    "preview": "npm run preview -w @arpanp/zen-ui",
    "test": "npx playwright test",
    "show": "node packages/reporter/bin/zen-reporter.js show",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:unused": "npx tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "spellcheck": "npx cspell lint .",
    "typecheck:core": "npm run build -w @arpanp/zen-core",
    "typecheck:ui": "tsc -p packages/ui/tsconfig.json --noEmit",
    "typecheck:reporter": "tsc -p packages/reporter/tsconfig.lib.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:core && npm run typecheck:ui && npm run typecheck:reporter && npm run typecheck:tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@duckdb/node-api": ">=2.0.0",
    "@playwright/test": ">=1.63.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cspell/eslint-plugin": "^10.4.0",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "cspell": "^10.4.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
